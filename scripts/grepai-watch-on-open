#!/usr/bin/env bash
# Start grepai background watcher if this repo has an index and watcher is stopped.
# Used by VS Code/Cursor folderOpen task.
#
# Best-effort only: always exit 0 so folderOpen never surfaces a red terminal error.
# Cold starts after reboot can exceed grepai's 30s ready-wait while the daemon is
# still scanning — treat that as soft success if the PID stays alive.
# Also auto-heals a known config parse failure: last_index_time with a space
# instead of RFC3339 "T" (written by older grepai, rejected by newer).
set -uo pipefail

GREPAI_BIN="${GREPAI_BIN:-${HOME}/.local/bin/grepai}"
ROOT="${1:-$(pwd)}"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/grepai/logs"
READY_POLL_SECONDS="${GREPAI_READY_POLL_SECONDS:-180}"
CONFIG="${ROOT}/.grepai/config.yaml"

soft_exit() {
  exit 0
}

if [[ ! -x "${GREPAI_BIN}" ]]; then
  echo "GrepAI binary not found or not executable at ${GREPAI_BIN}; skipping." >&2
  soft_exit
fi
if [[ ! -f "${CONFIG}" ]]; then
  echo "GrepAI config not found at ${CONFIG}; skipping." >&2
  soft_exit
fi
if ! cd "${ROOT}"; then
  echo "Failed to change directory to ${ROOT}; skipping." >&2
  soft_exit
fi

status_output() {
  "${GREPAI_BIN}" watch --status 2>&1 || true
}

is_running() {
  status_output | grep -qE 'Status:[[:space:]]+running'
}

worktree_id() {
  status_output | awk '/Worktree ID:/ {print $3; exit}'
}

pid_file() {
  local id
  id="$(worktree_id)"
  [[ -n "${id}" ]] || return 1
  echo "${STATE_DIR}/grepai-worktree-${id}.pid"
}

pid_alive() {
  local f pid
  f="$(pid_file)" || return 1
  [[ -f "${f}" ]] || return 1
  pid="$(tr -d '[:space:]' <"${f}")"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

heal_last_index_time() {
  if grep -qE 'last_index_time:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2} ' "${CONFIG}"; then
    sed -i -E 's/(last_index_time:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}) /\1T/' "${CONFIG}"
    echo "Auto-fixed .grepai/config.yaml last_index_time to RFC3339 (inserted T)."
    return 0
  fi
  return 1
}

wait_until_ready_or_alive() {
  local i
  echo "GrepAI watcher started; waiting for ready (cold start can exceed 30s)..."
  for ((i = 1; i <= READY_POLL_SECONDS; i++)); do
    if is_running; then
      echo "GrepAI watcher is ready."
      return 0
    fi
    if ! pid_alive; then
      echo "GrepAI watcher exited during startup." >&2
      return 1
    fi
    sleep 1
  done
  echo "GrepAI watcher is alive and still warming up; OK."
  return 0
}

try_start() {
  local out rc
  out="$("${GREPAI_BIN}" watch --background 2>&1)"
  rc=$?
  printf '%s\n' "${out}"
  return "${rc}"
}

if is_running; then
  echo "GrepAI watcher is already running."
  soft_exit
fi

"${GREPAI_BIN}" watch --stop >/dev/null 2>&1 || true
heal_last_index_time || true

echo "GrepAI watcher is not running. Attempting to start..."
START_OUT="$(try_start)"
START_RC=$?

if [[ ${START_RC} -eq 0 ]] || is_running; then
  echo "GrepAI watcher started successfully."
  soft_exit
fi

if printf '%s\n' "${START_OUT}" | grep -qiE 'failed to (load|parse) config|cannot parse|last_index_time'; then
  heal_last_index_time || true
  echo "Retrying GrepAI watcher start after config heal..."
  START_OUT="$(try_start)"
  START_RC=$?
  if [[ ${START_RC} -eq 0 ]] || is_running; then
    echo "GrepAI watcher started successfully after config heal."
    soft_exit
  fi
fi

if pid_alive; then
  wait_until_ready_or_alive || true
  soft_exit
fi

echo "GrepAI watcher did not start (exit ${START_RC}); continuing without watcher." >&2
if [[ -n "${START_OUT}" ]]; then
  echo "${START_OUT}" >&2
fi
echo "Check logs under: ${STATE_DIR}/grepai-worktree-*.log" >&2
soft_exit
